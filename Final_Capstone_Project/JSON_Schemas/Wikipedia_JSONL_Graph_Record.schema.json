{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Wikipedia_JSONL_Graph_Record.schema.json",
  "title": "Wikipedia JSONL Graph Record",
  "description": "Schema for one Wikipedia article-chunk JSONL record. The required fields match the current HTML chunker output; optional graph fields provide stable node, link, entity, and relationship data for later NetworkX graph construction and search.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Globally unique chunk identifier, for example Article_Name::chunk-0000."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Original Wikipedia HTML filename."
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable article identifier, normally the HTML filename stem."
    },
    "chunk_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero-based position of this chunk within its article."
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Normalized text content used for retrieval and evidence."
    },
    "metadata": {
      "$ref": "#/$defs/chunkMetadata"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable NetworkX node identifier. Defaults conceptually to id when absent."
    },
    "node_type": {
      "type": "string",
      "minLength": 1,
      "description": "Graph node category, such as article, chunk, entity, or section."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable Wikipedia article title."
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Ordered section headings containing this chunk."
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/articleLink"
      },
      "description": "Explicit article-to-article or chunk-to-article links extracted from the HTML."
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "description": "Entities identified in this chunk for graph nodes and entity search."
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      },
      "description": "Typed relationships extracted from this chunk for graph edges."
    }
  },
  "required": [
    "id",
    "source",
    "document_id",
    "chunk_index",
    "text",
    "metadata"
  ],
  "additionalProperties": false,
  "$defs": {
    "chunkMetadata": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "start_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "source",
        "document_id"
      ],
      "additionalProperties": true
    },
    "articleLink": {
      "type": "object",
      "properties": {
        "target_document_id": {
          "type": "string",
          "minLength": 1
        },
        "target_node_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_text": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1,
          "default": "links_to"
        }
      },
      "required": [
        "target_document_id",
        "relation"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "entity_id",
        "name",
        "entity_type"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "target_id",
        "relation"
      ],
      "additionalProperties": false
    }
  }
}
